# PostgreSQL — run: createdb financeos  (then: python database/migrate.py)
DATABASE_URL=postgresql://postgres@localhost:5432/financeos

QDRANT_HOST=localhost
QDRANT_PORT=6333

OLLAMA_BASE_URL=http://localhost:11434

PDF_STORAGE_PATH=./storage/pdfs

CLASSIFIER_MODEL=qwen2.5:3b
QA_MODEL=qwen2.5:7b
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

COLLECTION_NAME=company_financials
CLASSIFIER_CONFIDENCE_THRESHOLD=0.65
RETRIEVAL_TOP_K=20
RERANK_TOP_K=7